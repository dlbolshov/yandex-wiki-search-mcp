 "cards": [
  {
   "dot": "amber",
   "title": "Registration gates",
   "items": [
    "WIKI_READ_ONLY=true: only the 10 read tools",
    "Non-stdio or OAuth: no upload/download on server-host FS (31)",
    "stdio without OAuth: all 33, exactly manifest.json's list",
    "Server instructions use the same flags"
   ]
  },
  {
   "dot": "rose",
   "title": "Auth and organization",
   "items": [
    "Authorization: request token → WIKI_TOKEN → IAM (Bearer)",
    "?orgId= / ?cloudOrgId= replaces the whole org pair",
    "Under OAuth, client Bearer is the Yandex access token",
    "Without OAuth, HTTP calls use the server token"
   ]
  },
  {
   "dot": "cyan",
   "title": "WikiClient",
   "items": [
    "One client and one aiohttp session per lifespan",
    "Retries 429/502/503/504 and conn drops: GET (except download), search, upload_part",
    "Failures → WikiError hierarchy → is_error result",
    "Upload: session → 5 MiB parts → finish → attach"
   ]
  },
  {
   "dot": "violet",
   "title": "Delivery",
   "items": [
    "PyPI, MCPB, MCP Registry: stdio; GHCR image: stdio or streamable-http",
    "streamable-http: stateless, JSON responses, /healthz",
    "compose.yaml starts only Redis",
    "Code snapshot: main @ 054abf7"
   ]
  }
 ]
