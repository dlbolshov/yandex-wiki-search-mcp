 "cards": [
  {
   "dot": "cyan",
   "title": "Two modes",
   "items": [
    "Without highlight: top ≤ limit (max 50), cursors null: that is the whole set",
    "highlight=true: ≤10 per page, cursor = page number, up to ~100 results",
    "Filters (section, type, authors, dates) apply server-side before limit"
   ]
  },
  {
   "dot": "amber",
   "title": "When to stop",
   "items": [
    "End: empty results or next_cursor = null on a non-empty page",
    "Past the end, next_cursor keeps growing: never trust it alone",
    "Search has no fetch_all: the agent pages by hand"
   ]
  },
  {
   "dot": "rose",
   "title": "Why WikiClient checks",
   "items": [
    "API silently ignores cursor without highlight, returns page 1 again",
    "cluster matches literally: mixed case or a \"/\" gives 0 results",
    "Read-only POST: retried; an unreadable reply has no write warning"
   ]
  },
  {
   "dot": "violet",
   "title": "Result",
   "items": [
    "content: excerpt of up to ~510 chars, <em> only with highlight",
    "Page links get the WIKI_WEB_BASE_URL prefix; the web host is never called",
    "Before answering, the agent reads the page via page_get",
    "Mode behavior: live API probes, 2026-08 (docs/api-notes.md)"
   ]
  }
 ]
}
