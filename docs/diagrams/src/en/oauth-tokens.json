 "cards": [
  {
   "dot": "cyan",
   "title": "Whose tokens",
   "items": [
    "The server issues no tokens of its own: the client gets Yandex's pair as is",
    "The same access token goes to Wiki API as Authorization: OAuth",
    "Yandex code is exchanged for tokens only here, at /token"
   ]
  },
  {
   "dot": "violet",
   "title": "Store",
   "items": [
    "Redis: token keys are sha256, token and client_secret fields Fernet",
    "access lasts Yandex's expires_in, refresh 31 days",
    "Memory (default): unencrypted, single replica, lost on restart"
   ]
  },
  {
   "dot": "amber",
   "title": "Refresh",
   "items": [
    "Old refresh and access are deleted after the Yandex exchange",
    "The old Bearer gets 401 after refresh",
    "Public client: registration renewed, never for less than 31 days",
    "Not renewed for a client with a secret: lives until secret expiry, default 30 days from /register"
   ]
  },
  {
   "dot": "rose",
   "title": "Errors",
   "items": [
    "Wrong verifier → 400, code already burned: log in again",
    "Yandex refuses at /token → 400 invalid_grant, warning logged",
    "Missing or expired Bearer → 401, missing scope → 403",
    "Client registration expired → 401 invalid_client at /token, re-register",
    "No org in URL or settings → isError from the tool"
   ]
  }
 ]
