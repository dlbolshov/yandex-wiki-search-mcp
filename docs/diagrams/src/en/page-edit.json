 "cards": [
  {
   "dot": "slate",
   "title": "Scenario",
   "items": [
    "TRANSPORT=streamable-http, single-JSON response",
    "OAUTH_ENABLED=false, WIKI_READ_ONLY=false",
    "Endpoint URL with ?orgId=, one replacement, exactly 1 match"
   ]
  },
  {
   "dot": "cyan",
   "title": "Two Wiki requests",
   "items": [
    "GET v1/pages?slug=…&fields=content: read, no separate id lookup",
    "POST v1/pages/{id}?allow_merge=true: writes the full text",
    "One YandexAuth for both requests; headers rebuilt each time"
   ]
  },
  {
   "dot": "amber",
   "title": "Retries",
   "items": [
    "GET: up to WIKI_MAX_RETRIES+1 = 3 tries on 429/502/503/504, conn drop",
    "Timeout, 404, 500 and Retry-After > 3 s: no retry",
    "POST: one attempt; 5xx may come after the write"
   ]
  },
  {
   "dot": "rose",
   "title": "Errors",
   "items": [
    "No match, several matches, or a non-text page: error before POST",
    "A failed POST also gives isError, but the write may have landed",
    "ValueError and WikiError → ToolError → result with isError",
    "Client gets HTTP 200, not a JSON-RPC error"
   ]
  },
  {
   "dot": "violet",
   "title": "Not atomic",
   "items": [
    "No revision to lock on: the page may change between GET and POST",
    "allow_merge=true by default (page_update: false)",
    "NON_IDEMPOTENT_WRITE: a repeated call may replace again"
   ]
  }
 ]
}
