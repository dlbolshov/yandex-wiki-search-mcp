# Copy to .env and fill in. The .env file is gitignored — never commit real secrets.
# Settings are read from the environment and from this file (env vars take precedence).

# --- Authentication (at least one token; WIKI_TOKEN takes precedence when both are set) ---
# Yandex OAuth token for the Wiki API
WIKI_TOKEN=
# Or an IAM token (Yandex Cloud organizations)
#WIKI_IAM_TOKEN=

# --- Organization (exactly one) ---
# Yandex 360 organization id
WIKI_ORG_ID=
# Or a Yandex Cloud organization id
#WIKI_CLOUD_ORG_ID=

# --- Safety ---
# true disables all write tools (recommended for experiments against a production wiki)
WIKI_READ_ONLY=true

# --- Transport ---
# stdio (default) | sse | streamable-http
# Without OAUTH_ENABLED=true an HTTP endpoint authenticates nobody: keep it on
# loopback or put it behind an authenticating proxy. The local-file tools
# (page_upload_attachment, page_download_attachment) exist over stdio only.
#TRANSPORT=stdio
# Loopback by default. The Docker image sets 0.0.0.0 itself: leave HOST out
# of an env file passed to `docker run`, or the published port reaches nothing.
#HOST=127.0.0.1
#PORT=8000
# Host names the HTTP endpoint answers, comma-separated (DNS-rebinding
# protection). Unset: loopback names only without OAuth, no check with OAuth.
# List the names other clients use (a Compose service, a proxy's hostname);
# `*` switches the check off.
#MCP_ALLOWED_HOSTS=localhost,mcp-wiki
# streamable-http mode: keep no per-session state / respond with JSON instead of SSE
#STATELESS_HTTP=true
#JSON_RESPONSE=true

# --- Token economy ---
# Text duplicate of structured tool results: pretty (indent=2, spec-friendly
# default) | compact (single line, 10-30% smaller) | none (structured only —
# check your client renders structuredContent before enabling)
#TOOL_RESULT_TEXT=pretty

# --- Logging (stderr) ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL; DEBUG additionally logs Wiki API requests
#LOG_LEVEL=INFO

# --- Wiki endpoints (defaults are fine for wiki.yandex.ru) ---
#WIKI_API_BASE_URL=https://api.wiki.yandex.net
#WIKI_WEB_BASE_URL=https://wiki.yandex.ru
# OAuth | Bearer — Authorization header scheme for WIKI_TOKEN
#WIKI_AUTH_SCHEME=OAuth
# Retries for dropped connections and 429/502/503/504 on read requests; 0 disables them
#WIKI_MAX_RETRIES=2

# --- MCP OAuth provider (multi-user HTTP deployments only; not needed for local stdio) ---
#OAUTH_ENABLED=false
# memory | redis
#OAUTH_STORE=memory
#OAUTH_SERVER_URL=https://oauth.yandex.ru
#OAUTH_USE_SCOPES=true
#OAUTH_CLIENT_ID=
#OAUTH_CLIENT_SECRET=
# How long a dynamically registered client is kept unused, in seconds
# (default 30 days). Registration is unauthenticated by protocol design, so
# without an expiry every registration ever made is kept forever. Each
# sign-in or token refresh restarts the window, counted from when the tokens
# it issued run out; client secrets themselves never expire. Leave empty to
# disable. Formerly OAUTH_CLIENT_SECRET_EXPIRY_SECONDS, which is still read.
#OAUTH_REGISTRATION_IDLE_SECONDS=2592000
# Public URL of this MCP server (used for OAuth callbacks)
#MCP_SERVER_PUBLIC_URL=
# Comma-separated base64-encoded 32-byte keys (required for OAUTH_STORE=redis)
#OAUTH_ENCRYPTION_KEYS=

# --- Redis (only used when OAUTH_ENABLED=true and OAUTH_STORE=redis) ---
#REDIS_ENDPOINT=localhost
#REDIS_PORT=6379
#REDIS_DB=0
#REDIS_PASSWORD=
#REDIS_POOL_MAX_SIZE=10

# --- Development only (the server never reads this) ---
# Scratch slug for scripts/contract_sweep.py, which CREATES AND DELETES pages under
# it — point it at a spot in your personal section. Same value as the DRIFT_SWEEP_SLUG
# repository secret behind the weekly API drift check. With it set, the positional
# argument can be omitted: uv run python scripts/contract_sweep.py
#SWEEP_SLUG=users/<login>/contract-sweep
